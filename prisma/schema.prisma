generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─── NeoTennis Markov Quant — Ledger Schema ────────────────────────────────

model TennisMatch {
  id         String   @id @default(cuid())
  eventKey   String   @unique // espn competition id (stable per match)
  dateKey    String   // YYYYMMDD
  tour       String   // ATP | WTA
  tournament String
  city       String?
  surface    String   // HARD | CLAY | GRASS
  surfaceSrc String   // MAPPED | INFERRED
  round      String
  singles    Boolean  @default(true)
  playerA    String
  playerB    String
  flagA      String?
  flagB      String?
  rankA      Int?
  rankB      Int?
  pointsA    Float?
  pointsB    Float?
  status     String   // pre | in | post
  startTime  DateTime?
  favorite   String?  // A | B

  // ── Layer 1 (serve point + hold)
  pServeA Float?
  pServeB Float?
  holdA   Float?
  holdB   Float?

  // ── Layer 2/3 (set & match)
  setWinA Float?
  p20     Float?
  p21     Float?
  p12     Float?
  p02     Float?
  ou95    Float? // set over 9.5 games
  ou215   Float? // match over 21.5 games
  tb1     Float? // tiebreak in set 1

  // ── Market fusion (65% market / 35% surface Elo)
  marketProbA Float?
  marketOddsA Float?
  pEloA       Float?
  pEloB       Float?
  pFinalA     Float?
  pFinalB     Float?
  marketGap   Boolean @default(false)

  // ── Supervisor gate
  vetoed       Boolean @default(false)
  vetoReason   String?
  dualEligible Boolean @default(false)

  // ── Slips
  slipAText String?
  slipAOdds Float?
  slipAProb Float?
  slipBText String?
  slipBOdds Float?
  slipBProb Float?

  timing  String? // T-30m Pre-Warmup | In-Play After Early Break | ...
  hashPre String?

  // ── v5.0 Copula-Markov-MonteCarlo pipeline ──
  rho       Float?  // Gaussian copula ρ (Station 2)
  mcScore   Int?    // 10k Monte-Carlo score 0..100 (Station 4)
  mcEntropy Float?  // Shannon entropy of the match (Station 3)
  regime    String? // BANKER | COMBO | CLUSTER | DUAL_HEDGE | ACCUMULATOR
  crownTier String? // GOLD | SILVER

  // ── Settlement
  resultSetsA Int?
  resultSetsB Int?
  resultCode  String? // 2-0 | 2-1 | 1-2 | 0-2
  settled     Boolean @default(false)

  // ── v2.0 7-day historical auto-settlement marker
  historyProcessed Boolean @default(false)
  // ── v5.5 pipeline revision of the settlement processing (re-backfill marker)
  historyVersion   Int     @default(0)

  picks TennisPick[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TennisPick {
  id      String     @id @default(cuid())
  matchId String
  match   TennisMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  line    String // DUAL | COMBO | SNIPER | SHADOW | BANKER | CLUSTER
  leg     String // A | B | COMBO-2 | SNIPER-<key> | MW-FAV | SH-F15 | RC-* | CL-*
  desc    String
  odds    Float
  prob    Float
  stake   Float      @default(1)
  meta    String? // structured settlement payload (JSON)
  status  String     @default("PENDING") // PENDING | WON | LOST | VOID
  profit  Float?
  settledAt DateTime?

  // ── Audit v14 — where did this price come from?
  // MODEL_BOARD  = model probability inside the board window (not market-verified)
  // REAL_MARKET  = a real bookmaker/exchange quote locked this price
  // MANUAL_REAL  = operator-verified price entered via the Odds Reality panel
  oddsSource String @default("MODEL_BOARD")

  createdAt DateTime @default(now())

  @@unique([matchId, line, leg])
}

model EngineLog {
  id      String   @id @default(cuid())
  kind    String // FEED | SETTLE | TELEGRAM
  message String
  meta    String?
  createdAt DateTime @default(now())
}

// ── Audit v14 · Market Reality Layer ─────────────────────────────────────
// Real, verifiable bookmaker/exchange prices. The engine NEVER writes a
// synthetic row here. Sources: ESPN | POLYMARKET | BETFORWARD | ONEXBET | MANUAL.
model RealOddsQuote {
  id        String   @id @default(cuid())
  eventKey  String
  market    String   // MW | SB_2_0 | SB_2_1 | TS_O25 | TG_O205 | TG_U215 | GH_F35 ...
  line      String   // "" for MW, "2.5", "-3.5", "20.5" ...
  price     Float
  source    String
  // audit context
  playerA   String?
  playerB   String?
  matchLabel String?
  fetchedAt DateTime @default(now())

  @@unique([eventKey, market, line, source])
}

// ── Audit v14 · Append-only integrity trail ─────────────────────────────
// Written once, never rewritten. Records hash-verification results, gated
// migrations, real-quote locks and reality-check deviations.
model AuditEvent {
  id        String   @id @default(cuid())
  kind      String   // HASH_VERIFY | MIGRATION_SKIPPED | QUOTE_LOCKED | REALITY_CHECK | TIP_A_BACKTEST
  severity  String   @default("INFO") // INFO | WARN | CRITICAL
  message   String
  payload   String?
  createdAt DateTime @default(now())
}
